---
const screens = [
  { name: 'clients_overview',       label: 'Clients'             },
  { name: 'client_scopes_overview', label: 'Client Scopes'       },
  { name: 'idp_overview',           label: 'Identity Providers'  },
  { name: 'webhook_overview',       label: 'Webhooks'            },
].map((s) => ({
  ...s,
  light: `/console_preview/${s.name}-light.jpg`,
  dark: `/console_preview/${s.name}-dark.jpg`,
}))
---

<section class="border-b border-border" id="interface" aria-labelledby="ui-title">
  <div class="mx-auto max-w-6xl overflow-hidden border-x border-border">
    <div class="border-b border-border px-5 py-20 sm:px-8 sm:py-32">
      <p class="font-pixel text-[11px] uppercase tracking-[0.08em] text-primary" data-t="ui.label">Interface</p>
      <h2 id="ui-title" class="mt-6 max-w-2xl text-balance text-[clamp(2rem,4.5vw,3.5rem)] font-medium leading-[1.05] tracking-[-0.035em]" data-t="ui.title">
        Built for clarity, designed for speed
      </h2>
      <p class="mt-7 max-w-xl text-pretty text-[15px] leading-7 text-muted-foreground" data-t="ui.description">
        A clean admin UI to manage your realms, clients, users and permissions, without getting lost.
      </p>
    </div>

    <ul class="-mr-px grid sm:grid-cols-2">
      {screens.map((s) => (
        <li class="border-b border-r border-border">
          <button
            data-src-light={s.light}
            data-src-dark={s.dark}
            data-label={s.label}
            class="showcase-open group block w-full cursor-zoom-in text-left"
          >
            <div class="flex items-center gap-1.5 border-b border-border bg-surface-tint px-4 py-2.5">
              <span class="size-2 bg-muted-foreground/30"></span>
              <span class="size-2 bg-muted-foreground/30"></span>
              <span class="size-2 bg-muted-foreground/30"></span>
              <span class="ml-3 font-pixel text-[10px] uppercase tracking-[0.06em] text-muted-foreground">{s.label}</span>
            </div>
            <div class="overflow-hidden bg-surface-tint p-3 sm:p-4">
              <img src={s.light} alt={s.label} class="aspect-video w-full object-cover object-top transition-transform duration-300 group-hover:scale-[1.02] dark:hidden" loading="lazy" />
              <img src={s.dark} alt={s.label} class="hidden aspect-video w-full object-cover object-top transition-transform duration-300 group-hover:scale-[1.02] dark:block" loading="lazy" />
            </div>
          </button>
        </li>
      ))}
    </ul>
  </div>
</section>

<!-- Lightbox -->
<div
  id="showcase-lightbox"
  class="fixed inset-0 z-50 hidden items-center justify-center bg-black/80 p-4 backdrop-blur-sm"
  role="dialog"
  aria-modal="true"
>
  <button
    id="showcase-close"
    class="absolute right-4 top-4 flex size-10 cursor-pointer items-center justify-center border border-border bg-background text-foreground transition-colors hover:bg-foreground/[0.06]"
    aria-label="Close"
  >
    <svg xmlns="http://www.w3.org/2000/svg" class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M18 6L6 18M6 6l12 12"/>
    </svg>
  </button>

  <div class="relative w-full max-w-6xl overflow-hidden border border-border bg-background">
    <div class="flex items-center gap-1.5 border-b border-border px-4 py-2.5">
      <span class="size-2 bg-muted-foreground/30"></span>
      <span class="size-2 bg-muted-foreground/30"></span>
      <span class="size-2 bg-muted-foreground/30"></span>
    </div>
    <img id="showcase-lightbox-img" src="" alt="" class="w-full object-cover object-top" />
  </div>
</div>

<script>
  const lightbox = document.getElementById('showcase-lightbox')!
  const lightboxImg = document.getElementById('showcase-lightbox-img') as HTMLImageElement

  document.querySelectorAll<HTMLButtonElement>('.showcase-open').forEach(btn => {
    btn.addEventListener('click', () => {
      const dark = document.documentElement.classList.contains('dark')
      lightboxImg.src = (dark ? btn.dataset.srcDark : btn.dataset.srcLight)!
      lightboxImg.alt = btn.dataset.label!
      lightbox.classList.remove('hidden')
      lightbox.classList.add('flex')
    })
  })

  function close() {
    lightbox.classList.add('hidden')
    lightbox.classList.remove('flex')
  }

  document.getElementById('showcase-close')!.addEventListener('click', close)
  lightbox.addEventListener('click', (e) => { if (e.target === lightbox) close() })
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') close() })
</script>
