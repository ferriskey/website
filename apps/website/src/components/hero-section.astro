---
import { BackgroundAnimation } from "./background-animation";
import { Icon } from "@iconify/react";
import { Button } from "@explainer/ui";
---

<div
  class="relative px-4 sm:px-6 lg:px-8 flex flex-col justify-center min-h-[calc(100vh-3.5rem)] pt-12 sm:pt-16 lg:pt-20 pb-0! overflow-hidden"
>
  <div>
    <div class="absolute inset-0 w-full -z-10">
      <BackgroundAnimation client:load />
    </div>

    <!-- Decorative grid -->
    <div
      class="absolute inset-0 -z-5 pointer-events-none"
      style="clip-path: inset(0 -100vw 0 -100vw);"
      aria-hidden="true"
    >
      <div
        class="absolute inset-0 opacity-[0.07]"
        style="background-image: linear-gradient(to right, var(--color-primary) 1px, transparent 1px), linear-gradient(to bottom, var(--color-primary) 1px, transparent 1px); background-size: 56px 56px; mask-image: radial-gradient(ellipse 75% 65% at 50% 25%, black 0%, transparent 75%);"
      >
      </div>

      <!-- Corner accents -->
      <div class="absolute top-12 left-8 size-3 border border-primary/25 sm:top-16 sm:left-16"></div>
      <div class="hidden sm:block absolute top-20 right-16 size-4 border border-primary/20"></div>
      <div class="hidden sm:block absolute top-1/2 -left-2 size-2.5 border border-primary/20 -translate-y-1/2"></div>
      <div class="hidden sm:block absolute bottom-24 right-1/4 size-3 bg-primary/10"></div>
      <div class="hidden sm:block absolute bottom-16 left-1/3 size-2 bg-primary/10"></div>
    </div>

    <!-- Bottom separator -->
    <div
      class="absolute bottom-0 inset-x-0 h-px bg-linear-to-r from-transparent via-border to-transparent"
    >
    </div>

    <div class="w-full max-w-7xl mx-auto pb-24 lg:pb-32">
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">

        <!-- Left: text + actions -->
        <div>
          <div class="mb-6 hero-fade" style="--i:0">
            <a
              href="https://github.com/ferriskey/ferriskey"
              rel="noopener noreferrer"
              class="rounded-full font-semibold inline-flex items-center gap-2 transition-colors px-4 py-1.5 text-xs ring ring-inset ring-primary/50 text-primary hover:bg-primary/10 active:bg-primary/10 focus:outline-none focus-visible:ring-2 focus-visible:ring-primary"
            >
              <span>FerrisKey</span>
              <Icon icon="lucide:arrow-right" className="size-3.5" client:load />
            </a>
          </div>
          <h1 class="text-5xl tracking-tight text-foreground font-semibold sm:text-6xl lg:text-7xl leading-tight">
            <span class="hero-title-line"><span class="hero-title-line-inner" style="--i:0">A Modern IAM Built</span></span>
            <span class="hero-title-line"><span class="hero-title-line-inner" style="--i:1">for <span class="text-primary">Distributed</span></span></span>
            <span class="hero-title-line"><span class="hero-title-line-inner" style="--i:2">Systems</span></span>
          </h1>
          <p class="text-lg sm:text-xl/8 text-muted-foreground text-balance mt-6 hero-fade" style="--i:2">
            FerrisKey is an open-source, cloud-native Identity &amp; Access Management platform designed for Kubernetes, multi-tenancy, and modern security architectures.
          </p>

          <div class="mt-8 flex flex-wrap gap-x-4 gap-y-3 hero-fade" style="--i:3">
            <Button size="lg" className="cursor-pointer" client:load>
              <a
                href={`${import.meta.env.PUBLIC_DOCS_URL || ''}/en/discover/getting-started`}
                class="flex gap-2"
                rel="noopener noreferrer"
              >
                <span>Getting Started</span>
                <Icon icon="lucide:arrow-right" aria-hidden="true" className="size-5" client:load />
              </a>
            </Button>
            <Button variant="outline" size="lg" className="cursor-pointer" client:load>
              <a
                href="https://github.com/ferriskey/ferriskey"
                class="flex gap-2"
                target="_blank"
                rel="noopener noreferrer"
              >
                <Icon icon="lucide:github" aria-hidden="true" className="size-5" client:load />
                <span>View on GitHub</span>
              </a>
            </Button>
          </div>

          <div class="mt-8 flex items-center gap-x-8 gap-y-3 flex-wrap hero-fade" style="--i:4">
            <div class="flex items-center gap-2 text-sm text-muted-foreground">
              <Icon icon="lucide:code-2" className="size-4 text-primary/70" client:load />
              <span>Open source</span>
            </div>
            <div class="flex items-center gap-2 text-sm text-muted-foreground">
              <Icon icon="lucide:scale" className="size-4 text-primary/70" client:load />
              <span>Apache 2.0</span>
            </div>
            <div class="flex items-center gap-2 text-sm text-muted-foreground">
              <Icon icon="lucide:tag" className="size-4 text-primary/70" client:load />
              <span data-t="hero.badge.version">Early Access · v0.7.1</span>
            </div>
          </div>
        </div>

        <!-- Right: Product diagram, IAM at the center -->
        <div class="flex justify-center lg:justify-end items-center hero-diagram hero-fade" style="--i:2">
          <div class="relative w-full max-w-md">
            <div class="grid grid-cols-1 md:grid-cols-3 gap-px bg-border border border-border">

              <!-- Row 1 -->
              <div class="diagram-cell diagram-cell-cascade md:col-start-1 md:row-start-1 md:aspect-square group relative bg-background p-3 flex flex-col items-center justify-center gap-1.5 overflow-hidden transition-transform duration-300 ease-out hover:-translate-x-1 hover:-translate-y-1 hover:z-10 hover:bg-primary/[0.03] hover:shadow-[3px_3px_0_0_rgba(249,115,22,0.35)]" style="--ci:0">
                <span class="flex items-center justify-center size-7 bg-primary/10 text-primary transition-colors duration-300 group-hover:bg-primary/20">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4"><path d="M15.75 5.25a3 3 0 013 3m3 0a6 6 0 01-7.029 5.912c-.563-.097-1.159.026-1.563.43L10.5 17.25H8.25v2.25H6v2.25H2.25v-2.818c0-.597.237-1.17.659-1.591l6.499-6.499c.404-.404.527-1 .43-1.563A6 6 0 1121.75 8.25z"/></svg>
                </span>
                <span class="text-sm font-medium text-foreground font-mono">IdP</span>
              </div>
              <div class="diagram-cell diagram-cell-cascade md:col-start-2 md:row-start-1 md:aspect-square group relative bg-background p-3 flex flex-col items-center justify-center gap-1.5 overflow-hidden transition-transform duration-300 ease-out hover:-translate-x-1 hover:-translate-y-1 hover:z-10 hover:bg-primary/[0.03] hover:shadow-[3px_3px_0_0_rgba(249,115,22,0.35)]" style="--ci:1">
                <span class="flex items-center justify-center size-7 bg-primary/10 text-primary transition-colors duration-300 group-hover:bg-primary/20">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4"><path d="M15.75 9V5.25A2.25 2.25 0 0013.5 3h-6a2.25 2.25 0 00-2.25 2.25v13.5A2.25 2.25 0 007.5 21h6a2.25 2.25 0 002.25-2.25V15M12 9l3 3m0 0l-3 3m3-3H3"/></svg>
                </span>
                <span class="text-sm font-medium text-foreground font-mono">SSO</span>
              </div>
              <div class="diagram-cell diagram-cell-cascade md:col-start-3 md:row-start-1 md:aspect-square group relative bg-background p-3 flex flex-col items-center justify-center gap-1.5 overflow-hidden transition-transform duration-300 ease-out hover:-translate-x-1 hover:-translate-y-1 hover:z-10 hover:bg-sky-500/[0.03] hover:shadow-[3px_3px_0_0_rgba(14,165,233,0.35)]" style="--ci:2">
                <span class="flex items-center justify-center size-7 bg-sky-500/10 text-sky-500 transition-colors duration-300 group-hover:bg-sky-500/20">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4"><path d="M3.75 21h16.5M4.5 3h15M5.25 3v18m13.5-18v18M9 6.75h1.5m-1.5 3h1.5m-1.5 3h1.5m3-6H15m-1.5 3H15m-1.5 3H15M9 21v-3.375c0-.621.504-1.125 1.125-1.125h3.75c.621 0 1.125.504 1.125 1.125V21"/></svg>
                </span>
                <span class="text-sm font-medium text-foreground font-mono">Organizations</span>
              </div>

              <!-- Row 2 (hub centered) -->
              <div class="diagram-cell diagram-cell-cascade md:col-start-1 md:row-start-2 md:aspect-square group relative bg-background p-3 flex flex-col items-center justify-center gap-1.5 overflow-hidden transition-transform duration-300 ease-out hover:-translate-x-1 hover:-translate-y-1 hover:z-10 hover:bg-primary/[0.03] hover:shadow-[3px_3px_0_0_rgba(249,115,22,0.35)]" style="--ci:3">
                <span class="flex items-center justify-center size-7 bg-primary/10 text-primary transition-colors duration-300 group-hover:bg-primary/20">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4"><path d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z"/></svg>
                </span>
                <span class="text-sm font-medium text-foreground font-mono">MFA</span>
              </div>

              <div class="md:col-start-2 md:row-start-2 md:aspect-square relative bg-primary border border-foreground/10 flex items-center justify-center p-5 transition-transform duration-300 ease-out hover:-translate-y-1">
                <img src="/logo.svg" alt="FerrisKey" class="h-16 w-16" />
              </div>

              <div class="diagram-cell diagram-cell-cascade md:col-start-3 md:row-start-2 md:aspect-square group relative bg-background p-3 flex flex-col items-center justify-center gap-1.5 overflow-hidden transition-transform duration-300 ease-out hover:-translate-x-1 hover:-translate-y-1 hover:z-10 hover:bg-sky-500/[0.03] hover:shadow-[3px_3px_0_0_rgba(14,165,233,0.35)]" style="--ci:4">
                <span class="flex items-center justify-center size-7 bg-sky-500/10 text-sky-500 transition-colors duration-300 group-hover:bg-sky-500/20">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4"><path d="M9.53 16.122a3 3 0 00-5.78 1.128 2.25 2.25 0 01-2.4 2.245 4.5 4.5 0 008.4-2.245c0-.399-.078-.78-.22-1.128zm0 0a15.998 15.998 0 003.388-1.62m-5.043-.025a15.994 15.994 0 011.622-3.395m3.42 3.42a15.995 15.995 0 004.764-4.648l3.876-5.814a1.151 1.151 0 00-1.597-1.597L14.146 6.32a15.996 15.996 0 00-4.649 4.763m3.42 3.42a6.776 6.776 0 00-3.42-3.42"/></svg>
                </span>
                <span class="text-sm font-medium text-foreground font-mono">Branding</span>
              </div>

              <!-- Row 3 -->
              <div class="diagram-cell diagram-cell-cascade md:col-start-1 md:row-start-3 md:aspect-square group relative bg-background p-3 flex flex-col items-center justify-center gap-1.5 overflow-hidden transition-transform duration-300 ease-out hover:-translate-x-1 hover:-translate-y-1 hover:z-10 hover:bg-primary/[0.03] hover:shadow-[3px_3px_0_0_rgba(249,115,22,0.35)]" style="--ci:5">
                <span class="flex items-center justify-center size-7 bg-primary/10 text-primary transition-colors duration-300 group-hover:bg-primary/20">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4"><path d="M18 18.72a9.094 9.094 0 003.741-.479 3 3 0 00-4.682-2.72m.94 3.198l.001.031c0 .225-.012.447-.037.666A11.944 11.944 0 0112 21c-2.17 0-4.207-.576-5.963-1.584A6.062 6.062 0 016 18.719m12 0a5.971 5.971 0 00-.941-3.197m0 0A5.995 5.995 0 0012 12.75a5.995 5.995 0 00-5.058 2.772m0 0a3 3 0 00-4.681 2.72 8.986 8.986 0 003.74.477m.94-3.197a5.971 5.971 0 00-.94 3.197M15 6.75a3 3 0 11-6 0 3 3 0 016 0zm6 3a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0zm-13.5 0a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0z"/></svg>
                </span>
                <span class="text-sm font-medium text-foreground font-mono">RBAC</span>
              </div>
              <div class="diagram-cell diagram-cell-cascade md:col-start-2 md:row-start-3 md:aspect-square group relative bg-background p-3 flex flex-col items-center justify-center gap-1.5 overflow-hidden transition-transform duration-300 ease-out hover:-translate-x-1 hover:-translate-y-1 hover:z-10 hover:bg-sky-500/[0.03] hover:shadow-[3px_3px_0_0_rgba(14,165,233,0.35)]" style="--ci:6">
                <span class="flex items-center justify-center size-7 bg-sky-500/10 text-sky-500 transition-colors duration-300 group-hover:bg-sky-500/20">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4"><path d="M9 12.75L11.25 15 15 9.75M21 12c0 1.268-.63 2.39-1.593 3.068a3.745 3.745 0 01-1.043 3.296 3.745 3.745 0 01-3.296 1.043A3.745 3.745 0 0112 21c-1.268 0-2.39-.63-3.068-1.593a3.746 3.746 0 01-3.296-1.043 3.745 3.745 0 01-1.043-3.296A3.745 3.745 0 013 12c0-1.268.63-2.39 1.593-3.068a3.745 3.745 0 011.043-3.296 3.746 3.746 0 013.296-1.043A3.746 3.746 0 0112 3c1.268 0 2.39.63 3.068 1.593a3.746 3.746 0 013.296 1.043 3.746 3.746 0 011.043 3.296A3.745 3.745 0 0121 12z"/></svg>
                </span>
                <span class="text-sm font-medium text-foreground font-mono">Audits</span>
              </div>
              <div class="diagram-cell diagram-cell-cascade md:col-start-3 md:row-start-3 md:aspect-square group relative bg-background p-3 flex flex-col items-center justify-center gap-1.5 overflow-hidden transition-transform duration-300 ease-out hover:-translate-x-1 hover:-translate-y-1 hover:z-10 hover:bg-sky-500/[0.03] hover:shadow-[3px_3px_0_0_rgba(14,165,233,0.35)]" style="--ci:7">
                <span class="flex items-center justify-center size-7 bg-sky-500/10 text-sky-500 transition-colors duration-300 group-hover:bg-sky-500/20">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4"><path d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
                </span>
                <span class="text-sm font-medium text-foreground font-mono">Webhooks</span>
              </div>
            </div>

            <!-- Grid intersection dots -->
            <span class="hidden md:block absolute -top-[3px] left-1/3 -translate-x-1/2 size-[5px] bg-foreground/40"></span>
            <span class="hidden md:block absolute -top-[3px] left-2/3 -translate-x-1/2 size-[5px] bg-foreground/40"></span>
            <span class="hidden md:block absolute -bottom-[3px] left-1/3 -translate-x-1/2 size-[5px] bg-foreground/40"></span>
            <span class="hidden md:block absolute -bottom-[3px] left-2/3 -translate-x-1/2 size-[5px] bg-foreground/40"></span>

            <!-- Diamond accents -->
            <span class="hidden md:block absolute -left-6 top-1/4 size-5 border border-border rotate-45"></span>
            <span class="hidden md:block absolute -right-6 bottom-1/4 size-5 border border-primary/30 rotate-45"></span>
          </div>
        </div>

      </div>
    </div>
  </div>
</div>

<style>
  /* ── Hero entrance animations ── */
  @keyframes heroFadeUp {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .hero-fade {
    opacity: 0;
    animation: heroFadeUp 0.6s ease forwards;
    animation-delay: calc(var(--i) * 120ms + 100ms);
  }

  /* ── Hero title: per-line clipped slide-up reveal ── */
  .hero-title-line {
    display: block;
    overflow: hidden;
  }

  .hero-title-line-inner {
    display: block;
    transform: translateY(115%);
    animation: heroTitleLineUp 0.75s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    animation-delay: calc(var(--i) * 160ms + 100ms);
  }

  @keyframes heroTitleLineUp {
    to {
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-title-line-inner {
      animation: none;
      transform: translateY(0);
    }
  }

  /* ── Diagram cells: staggered cascade-in, after the panel has faded in ── */
  .diagram-cell-cascade {
    opacity: 0;
    transform: scale(0.8);
    animation: diagramCellIn 0.5s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    animation-delay: calc(950ms + var(--ci) * 90ms);
  }

  @keyframes diagramCellIn {
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .diagram-cell-cascade {
      animation: none;
      opacity: 1;
      transform: scale(1);
    }
  }
</style>
