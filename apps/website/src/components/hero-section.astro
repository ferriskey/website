---
import { PixelSprite } from './pixel/pixel-sprite'
import { crab, key } from './pixel/sprites'
import HeroWarehouse from './hero-warehouse.astro'
import HeroSupporters from './hero-supporters.astro'

const words = ['your customers.', 'your business clients.', 'your AI agents.', 'your workforce.', 'Kubernetes.']
const docsHref = `${import.meta.env.PUBLIC_DOCS_URL || ''}/en/discover/getting-started`

---

<section aria-labelledby="hero-title" class="relative flex min-h-[calc(100svh-3rem)] flex-col overflow-hidden border-b border-border">
  <div class="relative mx-auto flex w-full max-w-6xl flex-1 flex-col items-center border-x border-border px-5 pt-[clamp(4.5rem,13vh,8rem)] text-center">
    <a
      href="/release-notes"
      class="reveal group relative z-10 inline-flex items-center gap-3 border border-border bg-card py-1.5 pl-1.5 pr-3 text-sm text-foreground transition-colors hover:bg-foreground/[0.04]"
    >
      <span class="flex size-7 items-center justify-center bg-primary/10">
        <PixelSprite sprite={crab} className="size-4" />
      </span>
      <span>
        <span class="font-pixel text-[11px] uppercase text-primary">Open source</span> ·
        <span data-t="hero.badge.version">Early Access · v0.10.2</span>
      </span>
      <span class="transition-transform group-hover:translate-x-0.5" aria-hidden="true">→</span>
    </a>

    <h1
      id="hero-title"
      class="reveal mt-6 max-w-5xl text-[clamp(2.25rem,min(5.6vw,9vh),5rem)] font-medium leading-[1.02] tracking-[-0.04em] text-foreground"
      style="animation-delay: 0.1s"
    >
      <span class="block">
        <span data-t="hero.title.static">A modern IAM built for</span>
        <PixelSprite sprite={key} className="inline-block h-[0.55em] w-[1.2em] -translate-y-[0.04em] align-middle" />
      </span>
      <span class="roll block text-primary">
        <span class="roll-track">
          {words.map((w, i) => (
            <span class="roll-item block" data-t={`hero.roll.${i + 1}`} aria-hidden={i === 0 ? undefined : 'true'}>{w}</span>
          ))}
          <span class="roll-item block" aria-hidden="true" data-t="hero.roll.1">{words[0]}</span>
        </span>
      </span>
    </h1>

    <p
      class="reveal mt-7 max-w-xl text-pretty text-lg leading-8 text-muted-foreground"
      style="animation-delay: 0.2s"
      data-t="hero.description"
    >
      FerrisKey is an open-source, cloud-native Identity &amp; Access Management platform designed for Kubernetes, multi-tenancy, and modern security architectures.
    </p>

    <div class="reveal mt-8 flex flex-wrap justify-center gap-3" style="animation-delay: 0.3s">
      <a
        href={docsHref}
        class="inline-flex items-center gap-2 bg-primary px-5 py-3 text-sm font-semibold text-primary-foreground transition-opacity hover:opacity-90"
      >
        <span data-t="hero.primaryAction">Getting Started</span>
        <span aria-hidden="true">→</span>
      </a>
      <a
        href="https://github.com/ferriskey/ferriskey"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 border border-border bg-card px-5 py-3 text-sm font-semibold text-foreground transition-colors hover:bg-foreground/[0.04]"
      >
        <span data-t="hero.secondaryAction">View on GitHub</span>
      </a>
    </div>

  </div>
  <HeroWarehouse />
  <HeroSupporters />
</section>


<style>
  /* Le mot orange défile vers le haut : une ligne de haut, un mot par palier. */
  .roll {
    --line: 1.14em;
    height: var(--line);
    overflow: hidden;
  }
  .roll-track {
    display: block;
    animation: roll 14s infinite;
    animation-timing-function: cubic-bezier(0.7, 0, 0.2, 1);
  }
  .roll-item {
    height: var(--line);
    line-height: var(--line);
    white-space: nowrap;
  }
  /* 5 mots + 1 copie du premier : 5 paliers, retour invisible à la fin. */
  @keyframes roll {
    0%, 16% { transform: translateY(0); }
    20%, 36% { transform: translateY(calc(var(--line) * -1)); }
    40%, 56% { transform: translateY(calc(var(--line) * -2)); }
    60%, 76% { transform: translateY(calc(var(--line) * -3)); }
    80%, 96% { transform: translateY(calc(var(--line) * -4)); }
    100% { transform: translateY(calc(var(--line) * -5)); }
  }
  @media (prefers-reduced-motion: reduce) {
    .roll-track {
      animation: none;
    }
  }
</style>
