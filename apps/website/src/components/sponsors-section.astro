---
import { getSponsors } from '@explainer/ui/lib/sponsors'

const sponsors = getSponsors()
const lead = sponsors.find((s) => s.tier === 'lead')
const partners = sponsors.filter((s) => s.tier === 'partner')
const logo = 'max-h-8 max-w-[120px] object-contain opacity-80 transition-opacity group-hover:opacity-100'
---

<section class="border-b border-border" id="sponsors" aria-labelledby="sponsors-title">
  <div class="mx-auto max-w-6xl overflow-hidden border-x border-border">
    <div class="flex flex-wrap items-end justify-between gap-4 border-b border-border px-5 py-12 sm:px-8 sm:py-14">
      <div>
        <p class="font-pixel text-[11px] uppercase tracking-[0.08em] text-primary" data-t="sponsors.label">Sponsoring</p>
        <h2 id="sponsors-title" class="mt-3 max-w-xl text-balance text-2xl font-medium tracking-[-0.02em] sm:text-3xl" data-t="sponsors.title">
          Backed by companies who share our vision
        </h2>
      </div>
      <a href="mailto:contact@ferriskey.io" class="inline-flex items-center gap-2 border border-border bg-card px-4 py-2.5 text-sm font-semibold transition-colors hover:bg-foreground/[0.04]">
        <span data-t="sponsors.cta">Become a partner</span>
        <span aria-hidden="true">→</span>
      </a>
    </div>

    <p class="max-w-2xl border-b border-border px-5 py-9 text-sm leading-7 text-muted-foreground sm:px-8" data-t="sponsors.description">
      Our financial partners fund development, infrastructure, and the long-term roadmap. That's what keeps Ferriskey independent and moving fast.
    </p>

    {lead && (
      <a href={lead.href} target="_blank" rel="noopener noreferrer" class="group relative flex flex-col items-start gap-8 border-b border-border bg-surface-tint px-5 py-16 transition-colors hover:bg-foreground/[0.03] sm:flex-row sm:items-center sm:gap-12 sm:px-8">
        <span class="absolute right-5 top-4 font-pixel text-[10px] uppercase tracking-[0.08em] text-primary sm:right-8" data-t="sponsors.leadBadge">Lead Sponsor</span>
        <div class="shrink-0">
          <img src={lead.logoUrlLight} alt={lead.name} class="max-h-12 max-w-[220px] object-contain dark:hidden" />
          <img src={lead.logoUrlDark} alt={lead.name} class="hidden max-h-12 max-w-[220px] object-contain dark:block" />
        </div>
        <p class="max-w-xl text-sm leading-7 text-muted-foreground" data-t="sponsors.cloudiamTagline">
          Cloud IAM is a major supporter of Ferriskey. Their financial backing and identity expertise help the project grow in the open.
        </p>
      </a>
    )}

    <ul class="-mr-px grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5">
      {partners.map((s) => (
        <li class="border-b border-r border-border">
          <a href={s.href} target="_blank" rel="noopener noreferrer" title={s.name} class="group flex h-36 items-center justify-center px-4 transition-colors hover:bg-foreground/[0.03]">
            {s.logoUrlLight === s.logoUrlDark ? (
              <img src={s.logoUrlLight} alt={s.name} class={logo} loading="lazy" />
            ) : (
              <>
                <img src={s.logoUrlLight} alt={s.name} class={`${logo} dark:hidden`} loading="lazy" />
                <img src={s.logoUrlDark} alt={s.name} class={`${logo} hidden dark:block`} loading="lazy" />
              </>
            )}
          </a>
        </li>
      ))}
      <li class="border-b border-r border-border">
        <a href="https://github.com/sponsors/ferriskey" target="_blank" rel="noopener noreferrer" class="flex h-36 items-center justify-center px-4 transition-colors hover:bg-foreground/[0.03]">
          <span class="font-pixel text-[10px] uppercase tracking-[0.08em] text-muted-foreground" data-t="sponsors.placeholder">Your Logo</span>
        </a>
      </li>
    </ul>
  </div>
</section>
