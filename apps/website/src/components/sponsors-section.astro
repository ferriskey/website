---
import SectionHeader from './section-header.astro'
import { getSponsors } from '@explainer/ui/lib/sponsors'

const sponsors = getSponsors()
const lead = sponsors.find(s => s.tier === 'lead')
const partners = sponsors.filter(s => s.tier === 'partner')

const DOT_BG = 'background-image: radial-gradient(circle, currentColor 1.5px, transparent 1.5px); background-size: 20px 20px; color: var(--color-primary);'
---

<div class="w-full py-16 sm:py-24 lg:py-32">
  <div class="relative w-full max-w-7xl mx-auto px-5">

    <!-- dot pattern with progressive fade on all edges via mask -->
    <div
      class="absolute inset-0 pointer-events-none opacity-[0.06]"
      style={`${DOT_BG}; mask-image: radial-gradient(ellipse 80% 80% at 50% 50%, black 30%, transparent 100%);`}
      aria-hidden="true"
    ></div>

    <div class="relative flex flex-col items-center">
      <SectionHeader align="center" descriptionClass="max-w-xl" class="pt-8">
        <span slot="label" data-t="sponsors.label">Sponsoring</span>
        <span slot="title" data-t="sponsors.title">Backed by companies who share our vision</span>
        <span slot="description" data-t="sponsors.description">
          Our financial partners fund full-time development, infrastructure, and the long-term roadmap. That's what keeps Ferriskey independent and moving fast.
        </span>
      </SectionHeader>

      <a
        href="mailto:contact@ferriskey.io"
        data-anim="fade-up"
        class="inline-flex items-center gap-2 -mt-6 mb-12 sm:mb-16 border rounded-lg px-5 py-2.5 text-xs font-semibold uppercase tracking-widest text-foreground hover:bg-muted transition-colors"
      >
        <span data-t="sponsors.cta">Become a partner</span>
        <svg xmlns="http://www.w3.org/2000/svg" class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M7 17L17 7M7 7h10v10"/>
        </svg>
      </a>
    </div>

    <div class="relative flex flex-col gap-4 max-w-3xl mx-auto w-full">

      <!-- Lead sponsor: Cloud IAM -->
      {lead && (
        <a
          href={lead.href}
          target="_blank"
          rel="noopener noreferrer"
          data-anim="fade-up"
          style="transition-delay:80ms"
          class="group relative flex flex-col sm:flex-row items-center gap-6 sm:gap-10 border-2 border-primary/30 bg-primary/[0.03] hover:bg-primary/[0.06] transition-colors px-8 py-10 sm:py-12 overflow-hidden"
        >
          <span
            class="absolute top-4 right-4 sm:top-5 sm:right-5 text-[10px] font-semibold uppercase tracking-widest text-primary border border-primary/40 px-2 py-1"
            data-t="sponsors.leadBadge"
          >
            Lead Sponsor
          </span>
          <div class="shrink-0 flex items-center justify-center">
            <img src={lead.logoUrlLight} alt={lead.name} class="max-h-12 max-w-[220px] object-contain dark:hidden" />
            <img src={lead.logoUrlDark} alt={lead.name} class="max-h-12 max-w-[220px] object-contain hidden dark:block" />
          </div>
          <p class="text-sm sm:text-base text-muted-foreground leading-relaxed text-center sm:text-left" data-t="sponsors.cloudiamTagline">
            Strategic partner: Cloud IAM operates our managed Keycloak offering and is building toward Ferriskey as a Service.
          </p>
        </a>
      )}

      <!-- Secondary partners -->
      <div data-anim="fade-up" style="transition-delay:160ms" class="grid grid-cols-2 sm:grid-cols-3 gap-3">
        {partners.map(s => (
          <a
            href={s.href}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center justify-center border bg-muted/10 hover:bg-muted/20 transition-colors px-4 sm:px-6 py-8 overflow-hidden group"
          >
            {s.logoUrlLight === s.logoUrlDark ? (
              <img src={s.logoUrlLight} alt={s.name} class="max-h-8 max-w-[120px] object-contain opacity-80 group-hover:opacity-100 transition-opacity" />
            ) : (
              <>
                <img src={s.logoUrlLight} alt={s.name} class="max-h-8 max-w-[120px] object-contain opacity-80 group-hover:opacity-100 transition-opacity dark:hidden" />
                <img src={s.logoUrlDark} alt={s.name} class="max-h-8 max-w-[120px] object-contain opacity-80 group-hover:opacity-100 transition-opacity hidden dark:block" />
              </>
            )}
          </a>
        ))}
        <a
          href="https://github.com/sponsors/ferriskey"
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center justify-center border border-dashed border-border/40 bg-muted/5 hover:bg-muted/10 transition-colors px-4 sm:px-6 py-8 overflow-hidden"
        >
          <span class="text-xs font-semibold uppercase tracking-widest text-muted-foreground/40" data-t="sponsors.placeholder">Your Logo</span>
        </a>
      </div>
    </div>
  </div>
</div>
