---
import { PixelSprite } from './pixel/pixel-sprite'
import { crab, key } from './pixel/sprites'

interface Props {
  docsHref?: string
}
const { docsHref = '/' } = Astro.props
---

<section class="relative overflow-hidden border-b border-border" aria-labelledby="cta-title">
  <div class="mx-auto max-w-6xl border-x border-border">
    <div class="surface-brand relative px-5 py-28 text-center text-white sm:px-8 sm:py-44">
      <div class="bg-pixel-grid pointer-events-none absolute inset-0 opacity-60" aria-hidden="true"></div>
      <div class="relative flex flex-col items-center">
        <div class="flex items-center gap-3" aria-hidden="true">
          <PixelSprite sprite={crab} className="size-8" />
          <PixelSprite sprite={key} className="h-5 w-10" />
        </div>
        <p class="mt-8 font-pixel text-[11px] uppercase tracking-[0.08em] text-white/80" data-t="cta.label">Ready when you are</p>
        <h2 id="cta-title" class="mt-6 max-w-3xl text-balance text-[clamp(2.25rem,5.5vw,4.5rem)] font-medium leading-[1.02] tracking-[-0.04em]" data-t="cta.title">
          Your identity layer, your rules.
        </h2>
        <p class="mt-8 max-w-xl text-pretty text-lg leading-8 text-white/80" data-t="cta.description">
          Self-hosted, Apache 2.0, built in Rust. Deploy Ferriskey in minutes and own your authentication stack outright, with no vendor holding the keys.
        </p>
        <div class="mt-12 flex flex-wrap justify-center gap-3">
          <a href={docsHref} class="inline-flex items-center gap-2 bg-white px-6 py-3.5 text-sm font-semibold text-rust-900 transition-opacity hover:opacity-90">
            <span data-t="cta.primary">Get started</span>
            <span aria-hidden="true">→</span>
          </a>
          <a href="https://github.com/ferriskey/ferriskey" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 border border-white/40 px-6 py-3.5 text-sm font-semibold text-white transition-colors hover:bg-white/10">
            <span data-t="cta.github">View on GitHub</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
