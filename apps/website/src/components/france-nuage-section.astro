---
const features = [
  { id: 'sovereignty', title: 'Hosted in France', desc: 'Your data stays on French soil, out of reach of the US Cloud Act.' },
  { id: 'managed', title: 'Fully managed', desc: 'France Nuage handles updates, monitoring, and uptime, so your team can focus on using Ferriskey instead of running it.' },
  { id: 'compliance', title: 'GDPR ready', desc: 'Built for organizations that need to meet strict data protection requirements.' },
]
---

<section class="border-b border-border" id="france-nuage" aria-labelledby="fn-title">
  <div class="mx-auto grid max-w-6xl overflow-hidden border-x border-border lg:grid-cols-2">
    <div class="flex flex-col justify-between gap-10 border-b border-border px-5 py-16 sm:px-10 sm:py-24 lg:border-b-0 lg:border-r">
      <div>
        <p class="font-pixel text-[11px] uppercase tracking-[0.08em] text-primary" data-t="franceNuage.label">Partnership</p>
        <h2 id="fn-title" class="mt-4 text-balance text-[clamp(1.75rem,3.6vw,2.75rem)] font-medium leading-[1.08] tracking-[-0.03em]" data-t="franceNuage.title">
          Managed Ferriskey, hosted in France
        </h2>
        <p class="mt-6 max-w-md text-[15px] leading-7 text-muted-foreground" data-t="franceNuage.description">
          France Nuage is our cloud partner in France and runs the official managed Ferriskey offering on their infrastructure.
        </p>
        <div class="mt-10 flex h-16 w-fit items-center border border-border bg-card px-6">
          <img src="/sponsors/france-nuage-light.png" alt="France Nuage" class="max-h-9 max-w-[200px] object-contain dark:hidden" />
          <img src="/sponsors/france-nuage-dark.png" alt="France Nuage" class="hidden max-h-9 max-w-[200px] object-contain dark:block" />
        </div>
      </div>
      <a href="https://france-nuage.fr" target="_blank" rel="noopener noreferrer" class="inline-flex w-fit items-center gap-2 bg-primary px-5 py-3 text-sm font-semibold text-primary-foreground transition-opacity hover:opacity-90">
        <span data-t="franceNuage.cta">Deploy a managed Ferriskey with France Nuage</span>
        <span aria-hidden="true">→</span>
      </a>
    </div>

    <ul>
      {features.map((f) => (
        <li class="flex gap-5 border-b border-border px-5 py-10 last:border-b-0 sm:px-10 sm:py-14">
          <span class="mt-1.5 size-2.5 shrink-0 bg-primary" aria-hidden="true"></span>
          <div>
            <p class="text-base font-medium" data-t={`franceNuage.feature.${f.id}.title`}>{f.title}</p>
            <p class="mt-2 text-sm leading-6 text-muted-foreground" data-t={`franceNuage.feature.${f.id}.desc`}>{f.desc}</p>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>
