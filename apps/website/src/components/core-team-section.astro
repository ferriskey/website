---
const team = [
  { name: 'Nathael Bonnal', role: 'Co-Founder & Software Engineer', avatar: '/core/nathael.jpeg', github: 'https://github.com/nathaelb' },
  { name: 'Baptiste Parmantier', role: 'Co-Founder & Software Engineer', avatar: '/core/baptiste.jpeg', github: 'https://github.com/leadcodedev' },
  { name: 'Guillaume Leroy', role: 'Platform Engineer', avatar: '/core/guillaume.jpeg', github: 'https://github.com/leroyguillaume' },
  { name: 'Luis Rubiera', role: 'CTO @ Cloud-IAM', avatar: '/core/luis.jpeg', github: 'https://github.com/luisRubiera' },
]
---

<section class="border-b border-border" id="team" aria-labelledby="team-title">
  <div class="mx-auto max-w-6xl overflow-hidden border-x border-border">
    <div class="flex flex-wrap items-end justify-between gap-4 border-b border-border px-5 py-12 sm:px-8 sm:py-14">
      <div>
        <p class="font-pixel text-[11px] uppercase tracking-[0.08em] text-primary" data-t="team.label">Team</p>
        <h2 id="team-title" class="mt-3 text-2xl font-medium tracking-[-0.02em] sm:text-3xl" data-t="team.title">Meet the core team</h2>
      </div>
      <p class="max-w-md text-sm leading-6 text-muted-foreground" data-t="team.description">
        The people behind Ferriskey, building secure identity infrastructure in the open.
      </p>
    </div>

    <ul class="-mr-px grid grid-cols-2 lg:grid-cols-4">
      {team.map((m) => (
        <li class="group border-b border-r border-border">
          <a href={m.github} target="_blank" rel="noopener noreferrer" class="flex h-full flex-col gap-7 px-5 py-10 transition-colors hover:bg-foreground/[0.03] sm:px-8">
            <img src={m.avatar} alt={m.name} width="72" height="72" class="size-[72px] object-cover grayscale transition-[filter] duration-300 group-hover:grayscale-0" loading="lazy" />
            <div>
              <p class="text-sm font-semibold">{m.name}</p>
              <p class="mt-1 text-xs leading-5 text-muted-foreground">{m.role}</p>
            </div>
            <span class="mt-auto font-pixel text-[10px] uppercase tracking-[0.08em] text-muted-foreground transition-colors group-hover:text-primary">GitHub →</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>
