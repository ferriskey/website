---
import { readdirSync, readFileSync } from "node:fs"
import { join } from "node:path"
import { supportedLocales } from '../i18n/locale'

interface BlogPost {
  title: string
  description: string
  date: Date
  tags: string[]
  slug: string
  cover?: string
}

function parseFrontmatter(content: string): Record<string, any> {
  const match = content.match(/^---\n([\s\S]*?)\n---/)
  if (!match) return {}

  const yaml = match[1]
  const data: Record<string, any> = {}

  for (const line of yaml.split('\n')) {
    const kv = line.match(/^(\w[\w.]*)\s*:\s*(.+)$/)
    if (!kv) continue
    const [, key, rawValue] = kv
    let value: any = rawValue.trim()

    // Parse arrays like [tag1, tag2]
    if (value.startsWith('[') && value.endsWith(']')) {
      value = value.slice(1, -1).split(',').map((s: string) => s.trim().replace(/^['"]|['"]$/g, ''))
    }
    // Strip quotes
    else if ((value.startsWith('"') && value.endsWith('"')) || (value.startsWith("'") && value.endsWith("'"))) {
      value = value.slice(1, -1)
    }

    data[key] = value
  }

  return data
}

function loadBlogPosts(locale: string): BlogPost[] {
  const postsDir = join(process.cwd(), '..', 'blog', 'src', 'content', 'posts', locale)
  try {
    const files = readdirSync(postsDir).filter((f) => f.endsWith('.mdx') || f.endsWith('.md'))
    const posts: BlogPost[] = []

    for (const file of files) {
      const content = readFileSync(join(postsDir, file), 'utf-8')
      const data = parseFrontmatter(content)
      if (data.status !== 'published') continue

      posts.push({
        title: data.title ?? '',
        description: data.short_description ?? data.description ?? '',
        date: new Date(data.date),
        tags: Array.isArray(data.tags) ? data.tags : [],
        slug: file.replace(/\.mdx?$/, ''),
        cover: data.cover,
      })
    }

    return posts.sort((a, b) => b.date.getTime() - a.date.getTime()).slice(0, 3)
  } catch {
    return []
  }
}

const blogUrl = import.meta.env.PUBLIC_BLOG_URL || ''
const enPosts = loadBlogPosts('en')
const postsByLocale = supportedLocales.map((locale) => ({ locale, posts: loadBlogPosts(locale) }))

function formatDate(date: Date, locale: string) {
  return date.toLocaleDateString(locale, { year: 'numeric', month: 'short', day: 'numeric' })
}
---

{enPosts.length > 0 && (
  <section class="border-b border-border" id="articles" aria-labelledby="articles-title">
    <div class="mx-auto max-w-6xl overflow-hidden border-x border-border">
      <div class="flex flex-wrap items-end justify-between gap-4 border-b border-border px-5 py-12 sm:px-8 sm:py-14">
        <div>
          <p class="font-pixel text-[11px] uppercase tracking-[0.08em] text-primary" data-t="articles.label">Blog</p>
          <h2 id="articles-title" class="mt-3 text-2xl font-medium tracking-[-0.02em] sm:text-3xl" data-t="articles.title">Latest articles</h2>
        </div>
        <a href={blogUrl || '/'} class="font-pixel text-[10px] uppercase tracking-[0.08em] text-muted-foreground transition-colors hover:text-primary">
          <span data-t="articles.viewAll">View all articles</span> →
        </a>
      </div>

    {postsByLocale.map(({ locale, posts }) => (
    <ul data-locale-articles={locale} class="-mr-px grid md:grid-cols-3" style={locale === 'en' ? undefined : 'display: none;'}>
      {posts.map((post) => (
        <li class="border-b border-r border-border">
          <a href={`${blogUrl}/${locale}/${post.slug}`} class="group flex h-full flex-col transition-colors hover:bg-foreground/[0.03]">
            <div class="aspect-[16/10] overflow-hidden border-b border-border bg-muted">
              <img src={post.cover ?? `${blogUrl}/${locale}/${post.slug}/thumbnail.png`} alt={post.title} class="size-full object-cover transition-transform duration-300 group-hover:scale-105" loading="lazy" />
            </div>
            <div class="flex flex-1 flex-col px-5 py-8 sm:px-7">
              <div class="flex flex-wrap items-center gap-2">
                {post.tags.slice(0, 2).map((tag) => (
                  <span class="border border-border px-2 py-0.5 font-pixel text-[9px] uppercase tracking-[0.06em] text-primary">{tag}</span>
                ))}
                <time class="font-pixel text-[10px] uppercase tracking-[0.06em] text-muted-foreground">{formatDate(post.date, locale)}</time>
              </div>
              <h3 class="mt-5 line-clamp-2 text-lg font-medium leading-snug tracking-[-0.01em] transition-colors group-hover:text-primary">{post.title}</h3>
              <p class="mt-3 line-clamp-3 text-sm leading-6 text-muted-foreground">{post.description}</p>
            </div>
          </a>
        </li>
      ))}
    </ul>
    ))}
    </div>
  </section>
)}

<script>
  import { getClientLocale } from '../i18n/locale'

  function showLocaleArticles() {
    const locale = getClientLocale()

    document.querySelectorAll('[data-locale-articles]').forEach(function (el) {
      ;(el as HTMLElement).style.display = el.getAttribute('data-locale-articles') === locale ? '' : 'none'
    })
  }

  showLocaleArticles()
  document.addEventListener('astro:after-swap', showLocaleArticles)
  window.addEventListener('ferriskey:locale-change', showLocaleArticles)
</script>
