---
import Base from '../../layouts/base.astro'
import { WebsiteNavbar } from '../../components/website-navbar'
import SiteFooter from '../../components/site-footer.astro'
import ModuleVisual from '../../components/module-visual.astro'
import { PixelSprite } from '../../components/pixel/pixel-sprite'
import { modules, type FerrisModule } from '../../lib/modules'
import { moduleSprites } from '../../lib/module-sprites'

export function getStaticPaths() {
  return modules.map((mod) => ({
    params: { module: mod.slug },
    props: { mod, others: modules.filter((x) => x.slug !== mod.slug) },
  }))
}

const appUrlOverrides = {
  website: import.meta.env.PUBLIC_WEBSITE_URL,
  docs: import.meta.env.PUBLIC_DOCS_URL,
  blog: import.meta.env.PUBLIC_BLOG_URL,
}

const docsBase = appUrlOverrides.docs ?? ''
const { mod, others } = Astro.props as { mod: FerrisModule; others: FerrisModule[] }
const docsHref = `${docsBase}${mod.docsPath}`
const pad = (n: number) => String(n).padStart(2, '0')
---

<Base title={`${mod.name}: ${mod.tagline} | Ferriskey`} description={mod.description}>
  <WebsiteNavbar appUrlOverrides={appUrlOverrides} client:load transition:persist />

  <main>
    <!-- En-tête -->
    <section class="border-b border-border">
      <div class="mx-auto grid max-w-6xl border-x border-border lg:grid-cols-[1.1fr_1fr]">
        <div class="border-b border-border px-5 py-20 sm:px-8 sm:py-28 lg:border-b-0 lg:border-r">
          <a href="/modules" class="font-pixel text-[11px] uppercase tracking-[0.08em] text-muted-foreground transition-colors hover:text-primary">← Modules</a>
          <div class="mt-10 flex items-center gap-4">
            <PixelSprite sprite={moduleSprites[mod.slug]} className="block size-14" />
            <p class="font-pixel text-[11px] uppercase tracking-[0.08em] text-primary">{mod.tagline}</p>
          </div>
          <h1 class="mt-6 text-[clamp(2.75rem,6vw,5rem)] font-medium leading-[1] tracking-[-0.045em]">{mod.name}</h1>
          <p class="mt-7 max-w-xl text-pretty text-lg leading-8 text-muted-foreground">{mod.description}</p>
          <div class="mt-10 flex flex-wrap gap-3">
            <a href={docsHref} class="inline-flex items-center gap-2 bg-primary px-5 py-3 text-sm font-semibold text-primary-foreground transition-opacity hover:opacity-90">
              Read the docs <span aria-hidden="true">→</span>
            </a>
            <a href="/modules" class="inline-flex items-center gap-2 border border-border bg-card px-5 py-3 text-sm font-semibold transition-colors hover:bg-foreground/[0.04]">All modules</a>
          </div>
        </div>
        <aside class="flex items-center bg-surface-tint px-5 py-12 sm:px-8 sm:py-16">
          <div class="w-full"><ModuleVisual slug={mod.slug} name={mod.name} /></div>
        </aside>
      </div>
    </section>

    <!-- Ce qu'il couvre -->
    <section class="border-b border-border" aria-label="Covers">
      <div class="mx-auto flex max-w-6xl flex-wrap items-stretch border-x border-border">
        <p class="flex items-center border-r border-b border-border px-5 py-4 font-pixel text-[10px] uppercase tracking-[0.08em] text-primary sm:px-8">Covers</p>
        {mod.pills.map((p) => (
          <span class="flex items-center border-r border-b border-border px-4 py-4 text-sm text-muted-foreground">{p}</span>
        ))}
      </div>
    </section>

    <!-- Capacités -->
    <section class="border-b border-border">
      <div class="mx-auto max-w-6xl overflow-hidden border-x border-border">
        <div class="border-b border-border px-5 py-16 sm:px-8 sm:py-24">
          <p class="font-pixel text-[11px] uppercase tracking-[0.08em] text-primary">Key capabilities</p>
          <h2 class="mt-6 max-w-2xl text-balance text-[clamp(1.75rem,4vw,3rem)] font-medium leading-[1.05] tracking-[-0.035em]">What {mod.name} does for you.</h2>
        </div>
        <ul class="-mr-px grid sm:grid-cols-2 lg:grid-cols-3">
          {mod.features.map((f, i) => (
            <li class="feature group relative border-b border-r border-border px-6 py-12 transition-colors hover:bg-foreground/[0.03] sm:px-10 sm:py-14">
              <span class="font-pixel text-[10px] uppercase tracking-[0.08em] text-muted-foreground">{pad(i + 1)}</span>
              <h3 class="mt-8 text-lg font-medium tracking-[-0.01em]">{f.title}</h3>
              <p class="mt-3 text-sm leading-7 text-muted-foreground">{f.desc}</p>
              <span class="absolute inset-x-0 bottom-0 h-0.5 origin-left scale-x-0 bg-primary transition-transform duration-300 group-hover:scale-x-100" aria-hidden="true"></span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Comment ça marche -->
    <section class="border-b border-border">
      <div class="mx-auto max-w-6xl overflow-hidden border-x border-border">
        <div class="border-b border-border px-5 py-16 sm:px-8 sm:py-24">
          <p class="font-pixel text-[11px] uppercase tracking-[0.08em] text-primary">How it works</p>
          <h2 class="mt-6 max-w-2xl text-balance text-[clamp(1.75rem,4vw,3rem)] font-medium leading-[1.05] tracking-[-0.035em]">From the first request to the result, in {mod.steps.length} steps.</h2>
        </div>
        <ol class="-mr-px grid sm:grid-cols-2 lg:grid-cols-4">
          {mod.steps.map((s, i) => (
            <li class="relative border-b border-r border-border px-6 py-12 sm:px-8 sm:py-14">
              <span class="grid size-9 place-items-center bg-primary font-pixel text-[11px] text-primary-foreground">{i + 1}</span>
              <h3 class="mt-8 text-base font-medium tracking-[-0.01em]">{s.title}</h3>
              <p class="mt-3 text-sm leading-7 text-muted-foreground">{s.desc}</p>
              {i < mod.steps.length - 1 && (
                <span class="absolute right-0 top-[3.25rem] hidden h-px w-6 translate-x-1/2 bg-primary lg:block" aria-hidden="true"></span>
              )}
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- Appel à l'action -->
    <section class="relative overflow-hidden border-b border-border">
      <div class="mx-auto max-w-6xl border-x border-border">
        <div class="surface-brand relative px-5 py-20 text-white sm:px-8 sm:py-28">
          <div class="bg-pixel-grid pointer-events-none absolute inset-0 opacity-60" aria-hidden="true"></div>
          <div class="relative flex flex-col items-start justify-between gap-8 sm:flex-row sm:items-center">
            <div>
              <PixelSprite sprite={moduleSprites[mod.slug]} className="block size-10" />
              <h2 class="mt-6 text-balance text-[clamp(1.75rem,4vw,3rem)] font-medium leading-[1.05] tracking-[-0.035em]">Ready to use {mod.name}?</h2>
              <p class="mt-4 max-w-lg text-white/80">Full reference, configuration options, and examples in the documentation.</p>
            </div>
            <a href={docsHref} class="inline-flex shrink-0 items-center gap-2 bg-white px-6 py-3.5 text-sm font-semibold text-rust-900 transition-opacity hover:opacity-90">
              Open docs <span aria-hidden="true">→</span>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Les autres modules -->
    <section class="border-b border-border">
      <div class="mx-auto max-w-6xl overflow-hidden border-x border-border">
        <div class="border-b border-border px-5 py-12 sm:px-8">
          <p class="font-pixel text-[11px] uppercase tracking-[0.08em] text-primary">Other modules</p>
        </div>
        <ul class="-mr-px grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5">
          {others.map((m) => (
            <li class="other group relative border-b border-r border-border">
              <a href={`/modules/${m.slug}`} class="block px-5 py-8 transition-colors hover:bg-foreground/[0.03] sm:px-6 sm:py-10">
                <PixelSprite sprite={moduleSprites[m.slug]} className="other-sprite block size-9" />
                <p class="mt-6 text-base font-medium">{m.name}</p>
                <p class="mt-1 font-pixel text-[9px] uppercase leading-4 tracking-[0.06em] text-muted-foreground">{m.tagline}</p>
              </a>
              <span class="pointer-events-none absolute inset-x-0 bottom-0 h-0.5 origin-left scale-x-0 bg-primary transition-transform duration-300 group-hover:scale-x-100" aria-hidden="true"></span>
            </li>
          ))}
        </ul>
      </div>
    </section>
  </main>

  <SiteFooter />
</Base>

<style>
  .other-sprite {
    transition: transform 0.2s ease;
  }
  .other:hover .other-sprite {
    transform: translateY(-3px);
  }
  @media (prefers-reduced-motion: reduce) {
    .other:hover .other-sprite {
      transform: none;
    }
  }
</style>
