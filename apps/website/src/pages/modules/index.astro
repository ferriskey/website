---
import Base from '../../layouts/base.astro'
import { WebsiteNavbar } from '../../components/website-navbar'
import SiteFooter from '../../components/site-footer.astro'
import CtaSection from '../../components/cta-section.astro'
import { PixelSprite } from '../../components/pixel/pixel-sprite'
import { modules } from '../../lib/modules'
import { moduleSprites } from '../../lib/module-sprites'

const appUrlOverrides = {
  website: import.meta.env.PUBLIC_WEBSITE_URL,
  docs: import.meta.env.PUBLIC_DOCS_URL,
  blog: import.meta.env.PUBLIC_BLOG_URL,
}
const docsHref = `${appUrlOverrides.docs ?? ''}/en/discover/getting-started`

const short: Record<string, string> = {
  trident: 'TOTP, WebAuthn passkeys, magic links, and recovery codes.',
  seawatch: 'Track and query every critical action across your realms.',
  compass: 'Observe multi-step authentication with step timings and error details.',
  abyss: 'Connect Google, GitHub, Discord, and custom OIDC providers.',
  aegis: 'Control exactly what data flows into your tokens.',
  webhooks: 'Push lifecycle events to external systems, reliably.',
}
---

<Base title="Modules | Ferriskey" description="Purpose-built systems for authentication, audit, federation, and more.">
  <WebsiteNavbar appUrlOverrides={appUrlOverrides} client:load transition:persist />

  <main>
    <section class="border-b border-border">
      <div class="mx-auto max-w-6xl border-x border-border">
        <div class="border-b border-border px-5 py-20 sm:px-8 sm:py-32">
          <p class="font-pixel text-[11px] uppercase tracking-[0.08em] text-primary">Modules</p>
          <h1 class="mt-6 max-w-3xl text-balance text-[clamp(2.25rem,5vw,4.25rem)] font-medium leading-[1.03] tracking-[-0.04em]">
            Everything you need to build, one module at a time.
          </h1>
          <p class="mt-7 max-w-xl text-pretty text-lg leading-8 text-muted-foreground">
            FerrisKey is a collection of purpose-built modules. Each owns one aspect of identity and is configured independently, so you switch on what you need.
          </p>
          <div class="mt-10 flex flex-wrap gap-3">
            <a href={`${appUrlOverrides.docs ?? ''}/en/modules/overview`} class="inline-flex items-center gap-2 bg-primary px-5 py-3 text-sm font-semibold text-primary-foreground transition-opacity hover:opacity-90">
              Full documentation <span aria-hidden="true">→</span>
            </a>
            <a href="/" class="inline-flex items-center gap-2 border border-border bg-card px-5 py-3 text-sm font-semibold transition-colors hover:bg-foreground/[0.04]">Back to homepage</a>
          </div>
        </div>

        <ul class="-mr-px grid sm:grid-cols-2 lg:grid-cols-3">
          {modules.map((m) => (
            <li class="module group relative border-b border-r border-border">
              <a href={`/modules/${m.slug}`} class="block h-full px-6 py-12 transition-colors hover:bg-foreground/[0.03] sm:px-10 sm:py-16">
                <div class="flex items-center justify-between">
                  <PixelSprite sprite={moduleSprites[m.slug]} className="module-sprite block size-12" />
                  <span class="font-pixel text-[10px] uppercase tracking-[0.08em] text-muted-foreground">{m.slug}</span>
                </div>
                <p class="mt-10 font-pixel text-[10px] uppercase tracking-[0.08em] text-primary">{m.tagline}</p>
                <h2 class="mt-3 text-2xl font-medium tracking-[-0.02em]">{m.name}</h2>
                <p class="mt-3 text-sm leading-7 text-muted-foreground">{short[m.slug]}</p>
                <span class="mt-8 inline-flex items-center gap-2 text-sm font-semibold text-foreground">
                  Learn more <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">→</span>
                </span>
              </a>
              <span class="pointer-events-none absolute inset-x-0 bottom-0 h-0.5 origin-left scale-x-0 bg-primary transition-transform duration-300 group-hover:scale-x-100" aria-hidden="true"></span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <CtaSection docsHref={docsHref} />
  </main>

  <SiteFooter />
</Base>

<style>
  .module-sprite {
    transition: transform 0.2s ease;
  }
  .module:hover .module-sprite {
    transform: translateY(-3px);
  }
  @media (prefers-reduced-motion: reduce) {
    .module:hover .module-sprite {
      transform: none;
    }
  }
</style>
