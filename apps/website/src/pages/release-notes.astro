---
import Base from '../layouts/base.astro'
import { WebsiteNavbar } from '../components/website-navbar'
import SiteFooter from '../components/site-footer.astro'
import ReleaseSideScenes from '../components/release-side-scenes.astro'
import { latestRelease, releaseNotes } from '../lib/release-notes'

const appUrlOverrides = {
  website: import.meta.env.PUBLIC_WEBSITE_URL,
  docs: import.meta.env.PUBLIC_DOCS_URL,
  blog: import.meta.env.PUBLIC_BLOG_URL,
}

const docsHref = `${appUrlOverrides.docs ?? ''}/en/discover/getting-started`
const blogHref = appUrlOverrides.blog ?? '/'

const firstRelease = releaseNotes[releaseNotes.length - 1]

// One flat, chronological list (newest first) instead of a nested
// milestone/patch grouping: every release gets the same card shape, told
// apart only by its badge, title weight, and a colored accent for milestones.
const kindKey = {
  patch: 'releaseNotes.patch',
  minor: 'releaseNotes.minor',
  major: 'releaseNotes.major',
} as const

const kindLabel = {
  patch: 'Patch release',
  minor: 'Feature release',
  major: 'Milestone release',
} as const

const kindBadge = {
  patch: 'border-border text-muted-foreground',
  minor: 'border-primary/30 bg-primary/10 text-primary',
  major: 'border-primary/30 bg-primary/10 text-primary',
} as const

function formatDate(date: string, locale = 'en-US') {
  return new Date(date).toLocaleDateString(locale, {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  })
}
---

<Base
  title="Release Notes | Ferriskey"
  description="A curated timeline of Ferriskey releases, from the first stable baseline to federation, observability, and recovery flows."
>
  <WebsiteNavbar appUrlOverrides={appUrlOverrides} client:load transition:persist />

  <main>
    <section class="relative overflow-hidden border-b border-border">
      <ReleaseSideScenes />
      <div class="mx-auto grid max-w-6xl border-x border-border lg:grid-cols-[1.5fr_1fr]">
        <div class="border-b border-border px-5 py-20 sm:px-8 sm:py-32 lg:border-b-0 lg:border-r">
          <p class="font-pixel text-[11px] uppercase tracking-[0.08em] text-primary" data-t="releaseNotes.label">Release notes</p>
          <h1 class="mt-6 max-w-3xl text-balance text-[clamp(2.25rem,5vw,4.25rem)] font-medium leading-[1.03] tracking-[-0.04em]" data-t="releaseNotes.title">
            How Ferriskey has been taking shape, release after release.
          </h1>
          <p class="mt-7 max-w-xl text-pretty text-lg leading-8 text-muted-foreground" data-t="releaseNotes.description">
            A curated timeline of stable Ferriskey releases, condensed from the public GitHub history into product-level notes.
          </p>
          <p class="mt-4 max-w-xl text-sm text-muted-foreground" data-t="releaseNotes.basedOn">
            Based on the public release history of ferriskey/ferriskey on GitHub.
          </p>
          <div class="mt-10 flex flex-wrap gap-3">
            <a href={latestRelease.githubUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 bg-primary px-5 py-3 text-sm font-semibold text-primary-foreground transition-opacity hover:opacity-90">
              <span data-t="releaseNotes.github">GitHub release</span>
              <span aria-hidden="true">→</span>
            </a>
            <a href="/" class="inline-flex items-center gap-2 border border-border bg-card px-5 py-3 text-sm font-semibold transition-colors hover:bg-foreground/[0.04]">
              <span data-t="releaseNotes.back">Back to homepage</span>
            </a>
          </div>
        </div>

        <aside class="flex flex-col bg-surface-tint">
          <div class="flex-1 border-b border-border px-5 py-10 sm:px-8 sm:py-12">
            <div class="flex items-start justify-between gap-4">
              <p class="font-pixel text-[11px] uppercase tracking-[0.08em] text-primary" data-t="releaseNotes.latest">Latest stable</p>
              <span class="whitespace-nowrap border border-border px-2 py-1 font-pixel text-[10px] uppercase tracking-[0.06em] text-muted-foreground">
                <time data-release-date={latestRelease.publishedAt}>{formatDate(latestRelease.publishedAt)}</time>
              </span>
            </div>
            <h2 class="mt-6 text-5xl font-medium tracking-[-0.03em]">{latestRelease.version}</h2>
            <p class="mt-3 text-sm leading-6 text-muted-foreground" data-release-version={latestRelease.version} data-release-field="title">{latestRelease.title}</p>
          </div>
          <div class="grid grid-cols-2">
            <div class="border-r border-border px-5 py-7 sm:px-8">
              <p class="font-pixel text-[10px] uppercase tracking-[0.08em] text-muted-foreground" data-t="releaseNotes.stableCount">Stable releases</p>
              <p class="mt-3 text-3xl font-medium tabular-nums">{releaseNotes.length}</p>
            </div>
            <div class="px-5 py-7 sm:px-8">
              <p class="font-pixel text-[10px] uppercase tracking-[0.08em] text-muted-foreground" data-t="releaseNotes.timelineStart">Timeline start</p>
              <p class="mt-3 text-xl font-medium">{firstRelease.version}</p>
              <p class="mt-1 text-xs text-muted-foreground"><time data-release-date={firstRelease.publishedAt}>{formatDate(firstRelease.publishedAt)}</time></p>
            </div>
          </div>
        </aside>
      </div>
    </section>

    <section class="border-b border-border">
      <div class="mx-auto max-w-6xl border-x border-border">
        <div class="flex flex-wrap items-end justify-between gap-4 border-b border-border px-5 py-12 sm:px-8 sm:py-14">
          <div>
            <p class="font-pixel text-[11px] uppercase tracking-[0.08em] text-primary" data-t="releaseNotes.timeline">Stable release timeline</p>
            <p class="mt-4 max-w-xl text-sm leading-7 text-muted-foreground" data-t="releaseNotes.timelineHelp">
              Newest first. Milestone releases ship new capabilities; patch releases are quick fixes to an existing line.
            </p>
          </div>
        </div>

        <ol>
          {releaseNotes.map((release, index) => {
            const isLatest = index === 0
            const isMajor = release.kind === 'major'
            return (
              <li class:list={['relative grid border-b border-border last:border-b-0 md:grid-cols-[13rem_1fr]', isMajor && 'bg-surface-tint']}>
                {isMajor && <span class="absolute inset-y-0 left-0 w-1 bg-primary" aria-hidden="true"></span>}

                <div class="px-5 pt-10 sm:px-8 md:border-r md:border-border md:py-12">
                  <p class="text-2xl font-medium tracking-[-0.02em]">{release.version}</p>
                  <p class="mt-2 text-xs text-muted-foreground"><time data-release-date={release.publishedAt}>{formatDate(release.publishedAt)}</time></p>
                  <div class="mt-5 flex flex-wrap gap-2">
                    <span class={`border px-2 py-1 font-pixel text-[10px] uppercase tracking-[0.06em] ${kindBadge[release.kind]}`} data-t={kindKey[release.kind]}>
                      {kindLabel[release.kind]}
                    </span>
                    {isLatest && (
                      <span class="border border-emerald-500/30 bg-emerald-500/10 px-2 py-1 font-pixel text-[10px] uppercase tracking-[0.06em] text-emerald-600 dark:text-emerald-400" data-t="releaseNotes.latestBadge">
                        Latest release
                      </span>
                    )}
                  </div>
                </div>

                <article class="px-5 pb-12 pt-6 sm:px-10 md:py-12">
                  <h2
                    class:list={['text-balance font-medium tracking-[-0.02em]', isMajor ? 'text-2xl text-primary sm:text-3xl' : 'text-xl']}
                    data-release-version={release.version}
                    data-release-field="title"
                  >
                    {release.title}
                  </h2>
                  <p class="mt-4 max-w-2xl text-[15px] leading-7 text-muted-foreground" data-release-version={release.version} data-release-field="summary">
                    {release.summary}
                  </p>

                  <ul class="mt-7 max-w-2xl space-y-3">
                    {release.highlights.map((highlight, hIndex) => (
                      <li class="flex gap-4 text-sm leading-6 text-foreground/85" data-release-version={release.version} data-release-highlight-index={hIndex}>
                        <span class="mt-2 size-1.5 shrink-0 bg-primary" aria-hidden="true"></span>
                        <span>{highlight}</span>
                      </li>
                    ))}
                  </ul>

                  {release.transition && (
                    <p class="mt-7 max-w-2xl border-t border-border pt-5 text-xs leading-6 text-muted-foreground" data-release-version={release.version} data-release-field="transition">
                      {release.transition}
                    </p>
                  )}

                  <div class="mt-8 flex flex-wrap gap-2">
                    <a href={release.githubUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 border border-border bg-card px-3.5 py-2 font-pixel text-[10px] uppercase tracking-[0.08em] text-foreground transition-colors hover:border-primary hover:text-primary">
                      <span data-t="releaseNotes.github">GitHub release</span> <span aria-hidden="true">→</span>
                    </a>
                    {release.compareUrl && (
                      <a href={release.compareUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 border border-border px-3.5 py-2 font-pixel text-[10px] uppercase tracking-[0.08em] text-muted-foreground transition-colors hover:border-primary hover:text-primary">
                        <span data-t="releaseNotes.compare">Compare changes</span>
                      </a>
                    )}
                  </div>
                </article>
              </li>
            )
          })}
        </ol>
      </div>
    </section>
  </main>

  <SiteFooter docsHref={docsHref} blogHref={blogHref} />
</Base>

<script>
  import { getClientLocale } from '../i18n/locale'
  import { releaseNoteTranslations } from '../lib/release-notes'

  function applyReleaseTranslations() {
    const locale = getClientLocale()
    document.querySelectorAll<HTMLElement>('[data-release-version][data-release-field], [data-release-version][data-release-highlight-index]').forEach((el) => {
      const target = el.hasAttribute('data-release-highlight-index') ? el.querySelector('span:last-child')! : el
      if (target.getAttribute('data-original') === null) target.setAttribute('data-original', target.textContent ?? '')
      const release = releaseNoteTranslations[locale]?.[el.dataset.releaseVersion!]
      const text = el.dataset.releaseField
        ? release?.[el.dataset.releaseField as 'title' | 'summary' | 'transition']
        : release?.highlights?.[Number(el.dataset.releaseHighlightIndex)]
      target.textContent = text ?? target.getAttribute('data-original') ?? ''
    })
    document.querySelectorAll<HTMLElement>('[data-release-date]').forEach((el) => {
      el.textContent = new Date(el.dataset.releaseDate!).toLocaleDateString(locale, { year: 'numeric', month: 'long', day: 'numeric' })
    })
  }

  applyReleaseTranslations()
  document.addEventListener('astro:after-swap', applyReleaseTranslations)
  window.addEventListener('ferriskey:locale-change', applyReleaseTranslations)
</script>
