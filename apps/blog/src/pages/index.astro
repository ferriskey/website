---
import { getCollection } from 'astro:content'
import Base from '../layouts/base.astro'
import { TagFilter } from '../components/TagFilter'
import PostCard from '../components/PostCard.astro'
import { getPublishedPosts, getPostHref, getPostLocale, getPostsByLocale, getLocales, getAllTags, getReadingTime, getFeaturedPosts, getNonFeaturedPosts } from '../lib/posts'
import { getAuthor } from '../lib/authors'
import { defaultLang } from '../i18n/ui'
import { useTranslations } from '../i18n/utils'

const allPosts = await getCollection('posts')
const locales = getLocales(allPosts)
const posts = getPublishedPosts(allPosts)
const tags = getAllTags(posts)
const locale = defaultLang
const t = useTranslations(locale)

// Split into featured/rest per locale, not across the mixed-locale array:
// otherwise an EN and FR copy of the same post can both land in the 2
// featured slots, and hiding the wrong-locale one leaves an empty grid gap.
const postsByLocale = locales.map((loc) => {
  const localePosts = getPostsByLocale(posts, loc)
  return {
    loc,
    featured: getFeaturedPosts(localePosts, 2),
    rest: getNonFeaturedPosts(localePosts, 2),
  }
})

function cardProps(post: (typeof posts)[number]) {
  return {
    title: post.data.title,
    description: post.data.short_description ?? post.data.description,
    date: post.data.date,
    tags: post.data.tags,
    cover: post.data.cover ?? `${getPostHref(post)}/thumbnail.png`,
    href: getPostHref(post),
    locale: getPostLocale(post),
    readingTime: getReadingTime(post.body ?? ''),
    author: post.data.author ? getAuthor(post.data.author) : undefined,
  }
}
---

<Base title={t('index.title')} locale={locale} locales={locales}>
  <section class="border-b border-border" data-blog-locales={JSON.stringify(locales)}>
    <div class="mx-auto max-w-6xl border-x border-border px-5 py-20 sm:px-8 sm:py-32">
      <p class="font-pixel text-[11px] uppercase tracking-[0.08em] text-primary"><span data-blog-t="index.label">{t('index.label')}</span></p>
      <h1 class="mt-6 max-w-3xl text-balance text-[clamp(2.25rem,5.5vw,4.5rem)] font-medium leading-[1.03] tracking-[-0.04em]">
        <span data-blog-t="index.heading.prefix">{t('index.heading.prefix')}</span> <span class="text-primary"><span data-blog-t="index.heading.highlight">{t('index.heading.highlight')}</span></span>
      </h1>
    </div>
  </section>

  <div class="border-b border-border">
    <div class="mx-auto max-w-6xl overflow-hidden border-x border-border">
      <TagFilter tags={tags} totalCount={posts.length} locale={locale} client:load />

      {posts.length > 0 && (
        <div>
          {postsByLocale.map(({ loc, featured, rest }) => (
            <div data-locale={loc}>
              {featured.length > 0 && (
                <div class:list={['-mr-px grid grid-cols-1', featured.length > 1 && 'lg:grid-cols-2']}>
                  {featured.map((post) => (
                    <div class="border-b border-r border-border" data-tags={JSON.stringify(post.data.tags)} data-title={post.data.title} data-description={post.data.description ?? ''} data-locale={getPostLocale(post)}>
                      <PostCard {...cardProps(post)} featured />
                    </div>
                  ))}
                </div>
              )}

              {rest.length > 0 && (
                <div class="-mr-px grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3">
                  {rest.map((post) => (
                    <div class="border-b border-r border-border" data-tags={JSON.stringify(post.data.tags)} data-title={post.data.title} data-description={post.data.description ?? ''} data-locale={getPostLocale(post)}>
                      <PostCard {...cardProps(post)} />
                    </div>
                  ))}
                </div>
              )}
            </div>
          ))}
        </div>
      )}

      {posts.length === 0 && (
        <div class="px-5 py-24 text-center sm:px-8">
          <p class="text-lg text-muted-foreground">{t('index.empty')}</p>
        </div>
      )}
    </div>
  </div>
</Base>

<script>
  import { getClientLocale } from '@explainer/ui/lib/locale'
  import { useTranslations } from '../i18n/utils'

  function filterByLocale() {
    const locales: string[] = JSON.parse(document.querySelector<HTMLElement>('[data-blog-locales]')?.dataset.blogLocales ?? '[]')
    const preferred = getClientLocale()
    const detected = locales.includes(preferred) ? preferred : 'en'
    document.documentElement.lang = detected
    const t = useTranslations(detected)
    document.querySelectorAll<HTMLElement>('[data-blog-t]').forEach((el) => {
      el.textContent = t(el.dataset.blogT as Parameters<typeof t>[0])
    })
    document.querySelectorAll<HTMLElement>('[data-locale]').forEach((el) => {
      el.style.display = el.dataset.locale === detected ? '' : 'none'
    })
  }

  filterByLocale()
  document.addEventListener('astro:after-swap', filterByLocale)
  window.addEventListener('ferriskey:locale-change', filterByLocale)
</script>
