---
import Base from '../layouts/base.astro'
import { defaultLang } from '../i18n/ui'
import { PixelSprite } from '../components/pixel/pixel-sprite'
import { crabAsleep } from '../components/pixel/sprites'
---

<Base title="404 | Page not found" locale={defaultLang}>
  <section class="flex-1 border-b border-border">
    <div class="mx-auto flex h-full max-w-6xl flex-col items-center justify-center border-x border-border px-5 py-32 text-center">
      <PixelSprite sprite={crabAsleep} className="size-16" />
      <p class="mt-8 font-pixel text-[11px] uppercase tracking-[0.08em] text-primary">404</p>
      <h1 class="mt-4 text-4xl font-medium tracking-[-0.03em] md:text-5xl">Page not found</h1>
      <p class="mt-5 max-w-md text-lg text-muted-foreground">Sorry, we couldn't find the page you're looking for.</p>
      <a href="/" class="mt-10 inline-flex items-center gap-2 bg-primary px-5 py-3 text-sm font-semibold text-primary-foreground transition-opacity hover:opacity-90">
        Back to blog <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>
</Base>
