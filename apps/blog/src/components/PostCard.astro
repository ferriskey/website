---
import { formatDate } from '../lib/posts'
import type { Author } from '../lib/authors'

interface Props {
  title: string
  description?: string
  date: Date
  tags: string[]
  cover?: string
  href: string
  locale?: string
  readingTime: number
  author?: Author
  featured?: boolean
  class?: string
}

const { title, description, date, tags, cover, href, locale, author, featured = false, readingTime, class: className } = Astro.props
const category = tags[0]
---

<article class:list={['post-card group h-full', className]}>
  <a href={href} class="flex h-full flex-col transition-colors hover:bg-foreground/[0.03]">
    <div class:list={['shrink-0 overflow-hidden border-b border-border bg-muted', featured ? 'aspect-[16/9]' : 'aspect-[16/10]']}>
      {cover ? (
        <img src={cover} alt={title} class="size-full object-cover transition-transform duration-500 group-hover:scale-[1.03]" loading="lazy" />
      ) : (
        <div class="size-full bg-primary/10"></div>
      )}
    </div>
    <div class:list={['flex flex-1 flex-col px-5 py-8 sm:px-8', featured && 'sm:py-10']}>
      <div class="flex flex-wrap items-center gap-3">
        {category && (
          <span class="border border-border px-2 py-0.5 font-pixel text-[10px] uppercase tracking-[0.06em] text-primary">{category}</span>
        )}
        <time datetime={date.toISOString()} class="font-pixel text-[10px] uppercase tracking-[0.06em] text-muted-foreground">{formatDate(date, locale)}</time>
      </div>
      <h2 class:list={['mt-5 font-medium leading-snug tracking-[-0.02em] transition-colors group-hover:text-primary', featured ? 'text-2xl sm:text-3xl' : 'text-xl']}>
        {title}
      </h2>
      {description && <p class="mt-3 line-clamp-3 flex-1 text-sm leading-7 text-muted-foreground">{description}</p>}
      <div class="mt-7 flex items-center justify-between gap-3 font-pixel text-[10px] uppercase tracking-[0.06em] text-muted-foreground">
        <span class="truncate">{author?.name ?? 'FerrisKey'} · {readingTime} min</span>
        <span class="shrink-0 transition-transform duration-300 group-hover:translate-x-1 group-hover:text-primary" aria-hidden="true">→</span>
      </div>
    </div>
  </a>
</article>
