---
import '../styles/globals.css'
import { ClientRouter } from 'astro:transitions'
import { BlogNavbar } from '../components/blog-navbar'
import SiteFooter from '../components/site-footer.astro'
import { useTranslations } from '../i18n/utils'

interface Props {
  title: string
  description?: string
  thumbnail?: string
  locale?: string
  locales?: string[]
  localeSwitchUrls?: Record<string, string>
}

const { title, description = 'The FerrisKey blog: identity, security and Rust.', thumbnail, locale = 'en', locales = ['en'], localeSwitchUrls = {} } = Astro.props
const t = useTranslations(locale)
const thumbnailPath = thumbnail ?? `${Astro.url.pathname.replace(/\/$/, '')}/thumbnail.png`
// og:image/twitter:image must be absolute: Discord and most link-preview bots won't resolve a relative path.
const thumbnailUrl = Astro.site ? new URL(thumbnailPath, Astro.site).toString() : thumbnailPath

const appUrlOverrides = {
  website: import.meta.env.PUBLIC_WEBSITE_URL,
  docs: import.meta.env.PUBLIC_DOCS_URL,
  blog: import.meta.env.PUBLIC_BLOG_URL,
}
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={thumbnailUrl} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={thumbnailUrl} />
    <title>{title} | FerrisKey Blog</title>
    <ClientRouter />
    <script is:inline>
      (function () {
        var theme = localStorage.getItem('theme') || 'system'
        var isDark = theme === 'dark' || (theme === 'system' && window.matchMedia('(prefers-color-scheme: dark)').matches)
        document.documentElement.classList.toggle('dark', isDark)
      })()
    </script>
    <script is:inline>
      document.addEventListener('astro:after-swap', function () {
        var theme = localStorage.getItem('theme') || 'system'
        var isDark = theme === 'dark' || (theme === 'system' && window.matchMedia('(prefers-color-scheme: dark)').matches)
        document.documentElement.classList.toggle('dark', isDark)
      })
    </script>
  </head>
  <body class="min-h-screen antialiased flex flex-col">
    <BlogNavbar activePath={Astro.url.pathname} appUrlOverrides={appUrlOverrides} locale={locale} locales={locales} localeSwitchUrls={localeSwitchUrls} client:load transition:persist />
    <main class="flex-1 flex flex-col w-full">
      <slot />
    </main>
    <SiteFooter docsHref={appUrlOverrides.docs ?? '/'} websiteHref={appUrlOverrides.website ?? '/'} tagline={t('footer.tagline')} copyright={t('footer.text')} />
  </body>
</html>
