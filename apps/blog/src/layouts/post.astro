---
import Base from './base.astro'
import { formatDate } from '../lib/posts'
import { TableOfContents } from '../components/TableOfContents'
import { ShareButtons } from '../components/ShareButtons'
import { useTranslations } from '../i18n/utils'

interface Heading {
  depth: number
  slug: string
  text: string
}

interface Props {
  title: string
  description: string
  date: Date
  tags: string[]
  cover?: string
  thumbnail?: string
  readingTime: number
  headings: Heading[]
  url: string
  author?: { name: string; title: string; avatar: string; href?: string }
  locale?: string
  locales?: string[]
  localeSwitchUrls?: Record<string, string>
}

const { title, description, date, tags, cover, thumbnail, readingTime, headings, url, author, locale = 'en', locales, localeSwitchUrls } = Astro.props
const t = useTranslations(locale)
---

<Base title={title} description={description} thumbnail={thumbnail} locale={locale} locales={locales} localeSwitchUrls={localeSwitchUrls}>
  <article>
    <header class="border-b border-border">
      <div class="mx-auto max-w-6xl border-x border-border px-5 py-16 sm:px-8 sm:py-24">
        <a href="/" class="font-pixel text-[11px] uppercase tracking-[0.08em] text-muted-foreground transition-colors hover:text-primary">
          &larr; {t('post.back')}
        </a>
        <h1 class="mt-8 max-w-4xl text-balance text-[clamp(2.25rem,5vw,4rem)] font-medium leading-[1.04] tracking-[-0.04em]">{title}</h1>
        <p class="mt-6 max-w-2xl text-pretty text-lg leading-8 text-muted-foreground">{description}</p>
        <div class="mt-8 flex flex-wrap items-center gap-x-4 gap-y-3">
          <p class="font-pixel text-[10px] uppercase tracking-[0.08em] text-muted-foreground">
            {t('post.published')} {formatDate(date, locale)} · {readingTime} {t('hero.minRead')}
          </p>
          {tags.length > 0 && (
            <ul class="flex flex-wrap gap-2">
              {tags.map((tag) => (
                <li>
                  <a href={`/?tags=${encodeURIComponent(tag)}`} class="inline-block border border-border px-2.5 py-1 font-pixel text-[10px] uppercase tracking-[0.06em] text-muted-foreground transition-colors hover:border-primary hover:text-primary">
                    {tag}
                  </a>
                </li>
              ))}
            </ul>
          )}
        </div>
      </div>
    </header>

    {cover && (
      <div class="border-b border-border">
        <div class="mx-auto max-w-6xl border-x border-border">
          <img src={cover} alt={title} class="aspect-[2/1] w-full object-cover" />
        </div>
      </div>
    )}

    <div class="border-b border-border">
      <div class="mx-auto flex max-w-6xl gap-8 border-x border-border px-5 py-14 sm:px-8 sm:py-20">
        <!-- Left column: share buttons (sticky) -->
        <aside class="hidden w-12 shrink-0 lg:block">
          <ShareButtons url={url} title={title} locale={locale} client:load />
        </aside>

        <!-- Center column: article body -->
        <div class="min-w-0 max-w-3xl flex-1">
          <div class="prose prose-neutral dark:prose-invert max-w-none prose-headings:font-medium prose-headings:tracking-tight">
            <slot />
          </div>
          <div class="mt-12 lg:hidden">
            <ShareButtons url={url} title={title} locale={locale} horizontal client:load />
          </div>
        </div>

        <!-- Right column: table of contents (sticky) -->
        <aside class="hidden w-56 shrink-0 xl:block">
          <TableOfContents headings={headings} locale={locale} author={author} client:load />
        </aside>
      </div>
    </div>
  </article>
</Base>
