---
import { getCollection } from 'astro:content'
import { parsePath, buildHref, getLocales } from '../lib/docs'

const allDocs = await getCollection('docs')
const locales = getLocales(allDocs)

// Land on the getting started page of each locale, or on its lowest-order entry
const localeRedirects: Record<string, string> = {}
for (const locale of locales) {
  const landing = allDocs.find((e) => {
    const parsed = parsePath(e.id)
    return parsed.locale === locale && parsed.project === 'discover' && parsed.segments.join('/') === 'getting-started'
  })
  const first =
    landing ??
    allDocs
      .filter((e) => parsePath(e.id).locale === locale)
      .sort((a, b) => (a.data.order ?? Infinity) - (b.data.order ?? Infinity))[0]
  if (first) {
    localeRedirects[locale] = buildHref(first)
  }
}

const defaultRedirect = localeRedirects['en'] ?? Object.values(localeRedirects)[0] ?? '/'
---

<!doctype html>
<html data-locale-redirects={JSON.stringify(localeRedirects)} data-default-redirect={defaultRedirect}>
  <head>
    <meta charset="UTF-8" />
    <title>Redirecting...</title>
    <noscript><meta http-equiv="refresh" content={`0;url=${defaultRedirect}`} /></noscript>
  </head>
  <body>
    <script>
      import { getClientLocale } from '@explainer/ui/lib/locale'
      const redirects = JSON.parse(document.documentElement.dataset.localeRedirects ?? '{}')
      const fallback = document.documentElement.dataset.defaultRedirect ?? '/'
      window.location.replace(redirects[getClientLocale()] ?? fallback)
    </script>
    <p>Redirecting to <a href={defaultRedirect}>documentation</a>...</p>
  </body>
</html>
